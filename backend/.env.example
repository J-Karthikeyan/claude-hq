# Copy to .env (git-ignored). docker-compose.yml reads it; ARENA_DATABASE_URL and
# ARENA_PUBLIC_BASE_URL are set there for a compose deploy, so a VPS only needs
# the secret and the GitHub app.

# Signs pairing codes and websocket tickets. Generate with: openssl rand -base64 48
ARENA_SECRET_KEY=dev-only-insecure-change-me

# GitHub OAuth app (Settings -> Developer settings -> OAuth Apps).
# Authorization callback URL must be exactly:
#   <ARENA_PUBLIC_BASE_URL>/v1/auth/github/callback
ARENA_GITHUB_CLIENT_ID=
ARENA_GITHUB_CLIENT_SECRET=

# Local runs only (`cargo run --bin arena`):
ARENA_DATABASE_URL=sqlite:./arena.db
ARENA_PUBLIC_BASE_URL=http://127.0.0.1:8080
